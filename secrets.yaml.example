# 阿里云 DashScope API 配置
aliyun:
  api_key: "sk-ecbcc9186c2546448111388bae2fc90d"
  embedding_endpoint: "https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding"
